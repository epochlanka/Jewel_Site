JWT_SECRET="change-me"
PORT=4000
DB_PATH="data/jewellery.db"     # SQLite file, created on first start
UPLOAD_DIR="uploads"
STATIC_DIR="../frontend"         # the HTML/CSS/JS shop served on the same port
SITE_URL="http://localhost:4000"  # the shop's public address, used for links in emails

# Outgoing email for order confirmations. Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587,
# SMTP_USER = your Gmail address, SMTP_PASS = an app password (Google account > Security > App passwords).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""                     # defaults to SMTP_USER
